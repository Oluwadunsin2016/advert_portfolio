# Copy to .env.local and fill in. Never commit .env.local.

# EmailJS, for the contact form (emailjs.com). These are used in the browser,
# so they're public by design. Without them the form falls back to the
# visitor's email app.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional: your site's public address, for social-media previews
# NEXT_PUBLIC_SITE_URL=https://yourname.com
